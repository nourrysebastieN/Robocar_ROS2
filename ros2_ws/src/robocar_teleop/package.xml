<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robocar_teleop</name>
  <version>0.1.0</version>
  <description>Manette F710 lue par libevdev (/dev/input), logique de conduite de soukoukou. Remplace joy et joy_teleop.</description>
  <maintainer email="nourry203@gmail.com">nourrysebastieN</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_msgs</depend>
  <depend>robocar_msgs</depend>
  <depend>libevdev-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
